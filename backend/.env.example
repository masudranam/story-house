# PostgreSQL — matches ../docker-compose.yml dev service
DATABASE_URL=postgresql://storyhouse:storyhouse@localhost:5434/storyhouse?schema=public

PORT=3000
CORS_ORIGIN=http://localhost:4200

# REQUIRED — intentionally left empty so a copied file fails fast at boot.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=7d

BCRYPT_COST=12

# Rate limiting (applied to /auth/* routes)
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# e2e only (optional): overrides the disposable test DB used by npm run test:e2e.
# Must point at a throwaway database — the suite WIPES it on every run.
# TEST_DATABASE_URL=postgresql://storyhouse:storyhouse@localhost:5435/storyhouse_test?schema=public
