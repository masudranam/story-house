{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm ls*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx jest*)",
      "Bash(npx prisma *)",
      "Bash(npx @nestjs/cli*)",
      "Bash(npx nest *)",
      "Bash(npx @angular/cli*)",
      "Bash(npx ng *)",
      "Bash(node *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git mv *)",
      "PowerShell(npm run *)",
      "PowerShell(npm test*)",
      "PowerShell(npm install*)",
      "PowerShell(npm ci*)",
      "PowerShell(npx tsc*)",
      "PowerShell(npx eslint*)",
      "PowerShell(npx prettier*)",
      "PowerShell(npx jest*)",
      "PowerShell(npx prisma *)",
      "PowerShell(npx nest *)",
      "PowerShell(npx ng *)",
      "PowerShell(node *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "Edit(backend/**)",
      "Edit(frontend/**)",
      "Edit(docs/**)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking git command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking that edits were verified"
          }
        ]
      }
    ]
  }
}
